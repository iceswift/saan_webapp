# Copy values into the hosting provider's secrets, never commit credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/saan_staging?schema=public&sslmode=require"
NEXT_PUBLIC_SITE_URL="https://YOUR-STAGING-DOMAIN"
ADMIN_PHONES=""
# Explicit private test mode is required for mock or Omise sandbox collection.
PAYMENT_PROVIDER="unconfigured"
APP_ENV="staging"
STAGING_TEST_MODE="false"
STAGING_TEST_PHONES=""

# Sandbox collection: configure only after migration, key rotation and testing.
OMISE_TEST_SECRET_KEY=""
OMISE_API_VERSION="2019-05-29"
OMISE_WEBHOOK_ENABLED="false"
OMISE_WEBHOOK_SECRET=""
OMISE_WEBHOOK_PREVIOUS_SECRET=""
PAYMENT_RECONCILIATION_ENABLED="false"
PAYMENT_WORKER_SECRET=""
# Keep true during restore/reconciliation and until deliberate sandbox enablement.
PAYMENT_MUTATIONS_DISABLED="true"
