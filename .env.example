# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
DATABASE_URL="file:./dev.db"

# Development mock; opt-in omise_test supports sandbox PromptPay collection only.
# Public production payment activation remains unavailable.
PAYMENT_PROVIDER="mock"

# Contract spike ONLY; not connected to checkout. Never set a live key here.
# Set these in the shell/protected environment for npm run payment:omise:spike.
# OMISE_TEST_SECRET_KEY=""
# OMISE_API_VERSION="2019-05-29"
# OMISE_CONTRACT_SPIKE_CREATE="false"
# Checkout sandbox opt-in: PAYMENT_PROVIDER="omise_test" (test key/version also required).

# เบอร์โทรที่ได้สิทธิ์ผู้ดูแลระบบเมื่อเข้าสู่ระบบ คั่นด้วยจุลภาค
ADMIN_PHONES="0800000001"

# ที่อยู่เว็บจริง ใช้ทำลิงก์เต็มของรูปและหน้าที่แชร์ (Open Graph) ค่าเริ่มต้นคือ http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
