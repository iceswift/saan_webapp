# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
DATABASE_URL="file:./dev.db"

# เบอร์โทรที่ได้สิทธิ์ผู้ดูแลระบบเมื่อเข้าสู่ระบบ คั่นด้วยจุลภาค
ADMIN_PHONES="0800000001"

# ที่อยู่เว็บจริง ใช้ทำลิงก์เต็มของรูปและหน้าที่แชร์ (Open Graph) ค่าเริ่มต้นคือ http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
