// Generated by scripts/postgres-schema.mjs; edit prisma/schema.prisma instead.
// SQLite ใช้สำหรับพัฒนาในเครื่อง เมื่อขึ้นระบบจริงเปลี่ยน provider เป็น "postgresql"
// ค่าที่เป็นชุดตัวเลือก (role, status, kind) เก็บเป็น String เพราะ SQLite ไม่มี enum
// ชุดค่าที่ใช้ได้อยู่ใน src/lib/constants.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String   @default("")
  role      String   @default("CUSTOMER") // CUSTOMER | PROVIDER | ADMIN
  createdAt DateTime @default(now())
  deletedAt DateTime?

  // การตั้งค่า
  largeText     Boolean @default(false)
  notifyOrders  Boolean @default(true)
  notifyQuotes  Boolean @default(true)
  notifyVows    Boolean @default(true)

  sessions Session[]
  provider Provider?
  shrines  Shrine[]
  orders   Order[]
  requests ServiceRequest[]
  vows     Vow[]
  reviews  Review[]
  addresses     Address[]
  notifications Notification[]
  messages      OrderMessage[]
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Provider {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  kind        String // SHOP | BRAHMIN | TECHNICIAN | CARETAKER
  description String   @default("")
  phone       String
  areas       String // JSON array ของรหัสพื้นที่ เช่น ["BKK","NBI"]
  status      String   @default("PENDING") // PENDING | VERIFIED | REJECTED
  baseLat         Float? // ตำแหน่งร้าน (ใช้คำนวณระยะทาง)
  baseLng         Float?
  serviceRadiusKm Int? // รัศมีให้บริการ กม. ว่าง = ไม่จำกัดตามระยะ
  createdAt   DateTime @default(now())

  blockedDates ProviderBlockedDate[]
  products Product[]
  packages ServicePackage[]
  orders   Order[]
  quotes   Quote[]
  reviews  Review[]
}

/// วันที่ร้านไม่รับงาน (ลูกค้าเลือกวันนี้ไม่ได้)
model ProviderBlockedDate {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@unique([providerId, date])
}

model Product {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  kind        String // PHRA_PHUM | CHAO_THI | PAIR | PHRA_PHROM | MODERN
  price       Int // บาท
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  orderItems OrderItem[]
}

model ServicePackage {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type        String // CEREMONY | OFFERINGS | BASE | REMOVE_OLD
  name        String
  description String   @default("")
  price       Int // บาท
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  orderItems OrderItem[]
}

model Shrine {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  kind        String // เหมือน Product.kind
  area        String
  address     String    @default("")
  photoUrl    String?
  lat         Float?
  lng         Float?
  installedAt DateTime?
  createdAt   DateTime  @default(now())

  orders   Order[]
  requests ServiceRequest[]
  careLogs CareLog[]
}

model Order {
  id             String    @id @default(cuid())
  code           String    @unique // รหัสที่ลูกค้าเห็น เช่น SN-48213
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  providerId     String
  provider       Provider  @relation(fields: [providerId], references: [id])
  shrineId       String?
  shrine         Shrine?   @relation(fields: [shrineId], references: [id], onDelete: SetNull)
  requestId      String?   @unique
  request        ServiceRequest? @relation(fields: [requestId], references: [id])
  type           String // INSTALL | REMOVE | REPAIR
  status         String    @default("AWAITING_DEPOSIT")
  // AWAITING_DEPOSIT | AWAITING_PROVIDER | CONFIRMED | DONE | COMPLETED | CANCELLED
  shrineKind     String    @default("")
  placeType      String    @default("") // HOME | SHOP | FACTORY | ESTATE
  area           String
  address        String
  lat            Float? // ตำแหน่งที่ลูกค้าปักหมุด
  lng            Float?
  note           String    @default("")
  preferredDates String    @default("[]") // JSON array ของวันที่ YYYY-MM-DD ที่ลูกค้าสะดวก
  scheduledAt    DateTime? // วันเวลาที่ผู้ให้บริการยืนยัน
  total          Int
  deposit        Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items    OrderItem[]
  events   OrderEvent[]
  payments Payment[]
  moneyOperations MoneyOperation[]
  review   Review?
  messages OrderMessage[]

  @@index([userId])
  @@index([providerId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  packageId String?
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title     String
  note      String   @default("")
  photoUrl  String?
  byRole    String // CUSTOMER | PROVIDER | ADMIN | SYSTEM
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind       String // DEPOSIT | BALANCE
  amount     Int
  method     String // PROMPTPAY | CARD
  status     String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  gateway    String // ชื่อผู้ให้บริการชำระเงิน เช่น mock
  gatewayRef String    @default("")
  paidAt     DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  moneyOperations MoneyOperation[]

  @@index([orderId])
}

// Durable provider-neutral requests. Amounts are integer satang, unlike legacy Payment.amount (baht).
model MoneyOperation {
  id             String   @id @default(cuid())
  key            String   @unique
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  kind           String // PAYMENT_DEPOSIT | PAYMENT_BALANCE | REFUND | PAYOUT
  method         String   @default("")
  paymentId      String?
  payment        Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountMinor    Int
  status         String   @default("CREATED") // CREATED | PROCESSING | PENDING | SUCCEEDED | FAILED | UNKNOWN
  gateway        String   @default("mock")
  gatewayRef     String   @default("")
  error          String   @default("")
  requestedBy    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?

  @@index([orderId, kind])
  @@index([status, createdAt])
}

model ServiceRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  shrineId    String?
  shrine      Shrine?  @relation(fields: [shrineId], references: [id], onDelete: SetNull)
  type        String // REMOVE | REPAIR
  description String
  area        String
  address     String
  lat         Float?
  lng         Float?
  photoUrls   String   @default("[]") // JSON array
  status      String   @default("OPEN") // OPEN | ACCEPTED | CLOSED
  createdAt   DateTime @default(now())

  quotes Quote[]
  order  Order?

  @@index([userId])
}

model Quote {
  id         String         @id @default(cuid())
  requestId  String
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  price      Int
  note       String         @default("")
  status     String         @default("SENT") // SENT | ACCEPTED | DECLINED
  createdAt  DateTime       @default(now())

  @@unique([requestId, providerId])
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rating     Int // 1-5
  comment    String   @default("")
  photoUrls  String   @default("[]") // JSON array ของรูปงานจริง
  createdAt  DateTime @default(now())
}

model Vow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     String
  wish      String   @default("")
  promise   String
  status    String   @default("WAITING") // WAITING | GRANTED | FULFILLED
  remindAt   DateTime? // วันที่ผู้ใช้ขอให้เตือน
  remindedAt DateTime? // เวลาที่ระบบสร้างการแจ้งเตือนแล้ว
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // เช่น บ้าน ร้าน
  area      String
  address   String
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // ORDER | QUOTE | VOW | SYSTEM
  title     String
  body      String    @default("")
  href      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model OrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String   @default("")
  photoUrl  String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Provider-side simulated receipts, enabled only in explicitly gated staging.
model MockGatewayReceipt {
  key         String   @id
  fingerprint String
  reference   String   @unique
  createdAt   DateTime @default(now())
}

// Minimal authenticated webhook inbox. ISO UTC strings keep lease comparisons portable.
model ProviderWebhookEvent {
  id            String @id
  chargeId      String
  payloadHash   String
  receivedAt    String
  nextAttemptAt String
  leaseUntil    String @default("")
  leaseToken    String @default("")
  attempts      Int @default(0)
  processedAt   String?
  error         String @default("")

  @@index([processedAt, nextAttemptAt])
}

model CareLog {
  id        String   @id @default(cuid())
  shrineId  String
  shrine    Shrine   @relation(fields: [shrineId], references: [id], onDelete: Cascade)
  title     String
  note      String   @default("")
  photoUrl  String?
  doneAt    DateTime
  createdAt DateTime @default(now())

  @@index([shrineId])
}
