{
  "name": "saan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "payment:omise:spike": "node --conditions=react-server --import tsx scripts/omise-contract-spike.ts",
    "test:payment-provider": "node --conditions=react-server --import tsx --test tests/omise-test-client.test.ts tests/omise-test-gateway.test.ts tests/omise-webhook-signature.test.ts tests/payment-endpoints.test.ts",
    "test:payments:postgres": "node scripts/run-payment-postgres-tests.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:integration": "node scripts/test-integration.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:staging": "node scripts/seed-staging.mjs",
    "db:postgres:schema": "node scripts/postgres-schema.mjs",
    "db:postgres:check": "node scripts/postgres-schema.mjs --check",
    "db:postgres:generate": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:postgres:deploy": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "test:postgres": "node scripts/test-postgres.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "@types/leaflet": "^1.9.22",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.53.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
